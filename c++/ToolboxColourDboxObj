ToolboxColourDboxObj& ToolboxColourDboxObj::setNoneAvailable(int none) {
  _kernel_swi_regs regs;
  regs.r[2] = ColourDbox_SetNoneAvailable;
  regs.r[3] = none;
  this->objectMiscOp(&regs);
  return *this;
}

ToolboxColourDboxObj& ToolboxColourDboxObj::hideNoneAvailable() {
  return setNoneAvailable(0);
}

ToolboxColourDboxObj& ToolboxColourDboxObj::showNoneAvailable() {
  return setNoneAvailable(1);
}

int ToolboxColourDboxObj::isNoneAvailable() {
  _kernel_swi_regs regs;
  regs.r[2] = ColourDbox_GetNoneAvailable;
  this->objectMiscOp(&regs);
  return regs.r[0];
}

ToolboxColourDboxObj& ToolboxColourDboxObj::setObjectId(ObjectId objectId) {
  this->ToolboxObj::setObjectId(objectId);
  return *this;
}

ToolboxColourDboxObj& ToolboxColourDboxObj::setFlags(unsigned int flags) {
  this->ToolboxObj::setFlags(flags);
  return *this;
}

ToolboxColourDboxObj& ToolboxColourDboxObj::clearFlags() {
  this->ToolboxObj::clearFlags();
  return *this;
}
