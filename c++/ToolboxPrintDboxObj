#include "ToolboxPrintDboxObj.h"

ToolboxPrintDboxObj::ToolboxPrintDboxObj(ObjectId objectId) : ToolboxObj(objectId) {}

ToolboxPrintDboxObj::ToolboxPrintDboxObj(IdBlock *idBlock) : ToolboxObj(idBlock) {}

ObjectId ToolboxPrintDboxObj::getWindowId() {
  _kernel_swi_regs regs;
  regs.r[2] = PrintDbox_GetWindowId;
  this->objectMiscOp(&regs);
  return regs.r[0];
}

ToolboxPrintDboxObj& ToolboxPrintDboxObj::setPageRange(int start, int end) {
  _kernel_swi_regs regs;
  regs.r[2] = PrintDbox_SetPageRange;
  regs.r[3] = start;
  regs.r[4] = end;
  this->objectMiscOp(&regs);
  return *this;
}

void ToolboxPrintDboxObj::getPageRange(int *start, int *end) {
  _kernel_swi_regs regs;
  regs.r[2] = PrintDbox_GetPageRange;
  this->objectMiscOp(&regs);
  *start = regs.r[0];
  *end = regs.r[1];
}

int ToolboxPrintDboxObj::getPageRangeStart() {
  int start, end;
  getPageRange(&start, &end);
  return start;
}

int ToolboxPrintDboxObj::getPageRangeEnd() {
  int start, end;
  getPageRange(&start, &end);
  return end;
}

