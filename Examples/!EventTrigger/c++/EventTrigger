#include "EventTrigger.h"

EventTrigger::EventTrigger() : ToolboxTask(),
  res_Iconbar(NULL),
  res_Window(NULL),
  res_Menu(NULL) {}

EventTrigger::~EventTrigger() {
  if (res_Window != NULL) delete res_Window;
  if (res_Menu != NULL) delete res_Menu;
  if (res_Iconbar != NULL) delete res_Iconbar;
}

void EventTrigger::toolboxObjectAutoCreated(int objectClass) {
  switch(objectClass) {
    case ToolboxEvents::IconbarObjectClass: {
        iconbarObjectAutoCreated();
      }
      break;
    case ToolboxEvents::WindowObjectClass: {
        windowObjectAutoCreated();
      }
      break;
    case ToolboxEvents::MenuObjectClass: {
        menuObjectAutoCreated();
      }
      break;
    default:
      break;
  }
}

void EventTrigger::windowObjectAutoCreated() {
  ToolboxObjectAutoCreatedEvent *pollEvent = (ToolboxObjectAutoCreatedEvent *) getPollBlock();
  IdBlock *idBlock = &ToolboxCoreObj::idBlock;
  if (strcmp(pollEvent->template_name, "Window") == 0) {
    res_Window = new Res_Window(idBlock);
  }
}

void EventTrigger::menuObjectAutoCreated() {
  ToolboxObjectAutoCreatedEvent *pollEvent = (ToolboxObjectAutoCreatedEvent *) getPollBlock();
  IdBlock *idBlock = &ToolboxCoreObj::idBlock;
  if (strcmp(pollEvent->template_name, "Menu") == 0) {
    res_Menu = new Res_Menu(idBlock);
  }
}

void EventTrigger::iconbarObjectAutoCreated() {
  ToolboxObjectAutoCreatedEvent *pollEvent = (ToolboxObjectAutoCreatedEvent *) getPollBlock();
  IdBlock *idBlock = &ToolboxCoreObj::idBlock;
  if (strcmp(pollEvent->template_name, "Iconbar") == 0) {
    res_Iconbar = new Res_Iconbar(idBlock);
  }
}

void EventTrigger::toolboxEventHandler(int event) {
  switch(event) {
    case ToolboxEvents::QuitQuit: {
        quitQuit();
      }
      break;
    default:
      break;
  }
}

/*********************************************************
* Here res_Window->updateDisplay(event) method is used   *
* to pass on the Toolbox events.                         *
*********************************************************/
void EventTrigger::toolboxUserEvent(int event) {
  IdBlock *idBlock = &ToolboxCoreObj::idBlock;
  if (res_Window->readObjectId() == idBlock->self_id) {
    res_Window->updateDisplay(event);
  }
}

void EventTrigger::quitQuit() {
  quit = 1;
}

void EventTrigger::nullReason() {
  ToolboxEventTrigger::eventDispatcher();
}
