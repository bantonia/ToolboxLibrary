#include "EventTrigger.h"

int main() {
  EventTrigger *task = new EventTrigger();
  task->initTask("<EventTrigger$Dir>");
/***********************************
* Don't mask out Wimp_ENULL events *
***********************************/
  task->setMask(256);
/*****************************************
* Set the poll interval to a small value *
*****************************************/
  task->setPollIdleInterval(1);
  while (!task->quit) {
/*******************************************
* Use the tasks runIdle() method instead   *
* of run() to notice Wimp_ENULL events     *
*******************************************/
    task->runIdle();
  }
  delete task;
  return 0;
}
