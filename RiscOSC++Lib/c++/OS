void OS::readDirFileNames(_kernel_osgbpb_block *block) {
  _kernel_swi_regs in, out;
  in.r[0] = GBPB_ReadEntriesFromCurrentDir;
  in.r[2] = (int) block->dataptr;
  in.r[3] = block->nbytes;
  in.r[4] = block->fileptr;
  gbpb(&in, &out);
  block->nbytes = out.r[3];
  block->fileptr = out.r[4];
}

void OS::readDirEntries(char *path, _kernel_osgbpb_block *block, int readType) {
  _kernel_swi_regs in, out;
  if ((readType == GBPB_ReadEntriesFromSpecifiedDir)
       || (readType == GBPB_ReadEntriesAndFileInfoFromDir)
       || (readType == GBPB_ReadEntriesAndFullFileInfoFromDir)
       || (readType == GBPB_ReadEntriesAndFileTypeInfoFromDir)) {
    in.r[0] = readType;
    in.r[1] = (int) path;
    in.r[2] = (int) block->dataptr;
    in.r[3] = block->nbytes;
    in.r[4] = block->fileptr;
    in.r[5] = block->buf_len;
    in.r[6] = (int) block->wild_fld;
    gbpb(&in, &out);
    block->nbytes = out.r[3];
    block->fileptr = out.r[4];
  }
}
