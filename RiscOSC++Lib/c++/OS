void OS::gbpb(_kernel_swi_regs *in, _kernel_swi_regs *out) {
  ErrorReport::setLastError(_kernel_swi(OS_GBPB, in, out), __LINE__);
}

void OS::writeBytesToFile(int handle, _kernel_osgbpb_block *block, int pointerType) {
  _kernel_swi_regs in, out;
  if ((pointerType == GBPB_WriteBytesSpecifiedPointer) || (pointerType == GBPB_WriteBytesCurrentPointer)) {
    in.r[0] = pointerType;
    in.r[1] = handle;
    in.r[2] = (int) block->dataptr;
    in.r[3] = block->nbytes;
    in.r[4] = block->fileptr;
    gbpb(&in, &out);
    block->dataptr = (void *) out.r[2];
    block->nbytes = out.r[3];
    block->fileptr = out.r[4];
  }
}


