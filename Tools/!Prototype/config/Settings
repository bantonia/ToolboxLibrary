# Lines beginning with a # are considered as comments and can contain spaces.
#
# No lines can be left empty.
#
# Directives end with a colon and the line must not contain spaces.
#
# End of file must not end on an empty line.
#
# Directories to be created
Directories:c++,h,o
#
# Prefix to be appended to resource file object names
ResPrefix:Res_
#
# BraceStyle can be either staggered or matched
BraceStyle:matched
#
# Indentation, accepted values 0-4
Indentation:4
#
# Options menu choices 
# To be ticked set as ticked, Unticked leave clear and end the line with a colon.
GenerateDirectories:ticked
ResourceClassPrefix:ticked
GenerateMain:ticked
GenerateTaskClass:ticked
GenerateResClasses:ticked
IncludeHeaderText:ticked
IncludeComments:ticked
