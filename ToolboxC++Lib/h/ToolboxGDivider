#ifndef__cplusplus
#error Header file "ToolboxGDivider.h" may only be used from C++
#endif
#pragma force_top_level
#pragma include_only_once

#ifndef __ToolboxGDivider_h
#define __ToolboxGDivider_h

#include "ClassType.h"
#include "ToolboxGadget.h"
#include "ToolboxWindowObj.h"
#include "toolbox.h"

#define GDivider_00      0x140580
#define GDivider_Divider 0x140580

/* Gadget SWIs */
#define Divider_Add                 (GDivider_Divider + 1)
#define Divider_Remove              (GDivider_Divider + 2)
#define Divider_Fade                (GDivider_Divider + 3)
#define Divider_Plot                (GDivider_Divider + 9)
#define Divider_Redraw              (GDivider_Divider + 16)

#define Divider_Base                0x4058
#define Divider_TemplateSize        36
#define Divider_Type                ((Divider_TemplateSize << 16) | Divider_Base)
#define Divider_ValidFlags          0xC0000007u
#define Divider_Vertical            0x00000001u
#define Divider_Flat                0x00000002u
#define Divider_Gradient            0x00000004u
#define Divider_Faded               0x80000000u

/* Miscellaneous gadget methods */ 
#define Divider_MiscOp_Base          1024
#define Divider_SetColour           (Divider_MiscOp_Base + 0)
#define Divider_GetColour           (Divider_MiscOp_Base + 1)
#define Divider_SetThickness        (Divider_MiscOp_Base + 2)
#define Divider_GetThickness        (Divider_MiscOp_Base + 3)
#define Divider_SetInset            (Divider_MiscOp_Base + 4)
#define Divider_GetInset            (Divider_MiscOp_Base + 5)

/* Values for the gadget setColour method flags */
#define DividerColour_Primary        0x00000001u
#define DividerColour_Secondary      0x00000002u
#define DividerColour_Direction      0x00000004u
#define DividerColour_All            0x00000007u

class ToolboxGDivider : public ToolboxGadget {
  public:

    typedef struct {
      int xmin, ymin, xmax, ymax;
    } BBox;

    typedef struct {
      unsigned int flags;
      int          type;
      BBox         box;
      int          component_id;
      char*        help_message;
      int          max_help;
    } DividerGadget;

    ToolboxGDivider();
    ToolboxGDivider(ObjectId windowId, ComponentId gadgetId);
    ToolboxGDivider(ObjectId windowId, ComponentId gadgetId, unsigned int flags);
    ~ToolboxGDivider();

    ComponentId add(int, DividerGadget *);
    ComponentId add(ToolboxWindowObj *, DividerGadget *);
    void remove();
    ToolboxGDivider& fade(int);
    ToolboxGDivider& plot();
    ToolboxGDivider& redraw(int, int);
    ToolboxGDivider& setColour(unsigned int);
    void getColour(int&, int&, int&);
    ToolboxGDivider& setThickness(int);
    int getThickness();
    ToolboxGDivider& setInset(int);
    int getInset();

    void showProperties() {}
    char* getClassName() { return "ToolboxGDivider";}
    int getClassType() { return ClassType_ToolboxGDivider;}

  private:

    typedef struct {
      int          window;            /* wimp window handle */
      int          icon;              /* wimp icon handle   */
      int          component_id;
      int          icon_list[2];      /* { icon, -1 }, kept per-instance so
                                       * a second divider_add cannot
                                       * overwrite the first caller's list
                                       * before the Window module reads it. */

      unsigned int flags;             /* gadget flags at add time, kept so
                                       * a later resize/recolour can rebuild
                                       * the icon without the caller handing
                                       * the template back */
      BBox         gadget_box;        /* the gadget's own (undivided) box */

      int          thickness;         /* flat/gradient only, OS units */
      int          inset;             /* flat/gradient only, OS units */
      unsigned int colour1;           /* RRGGBB: flat colour, gradient start */
      unsigned int colour2;           /* RRGGBB: gradient end (unused if flat
                                       * without Divider_Gradient) */
      int          direction;         /* 0 = colour1 at box min, 1 = at max */

      char         validation[12];    /* "C/BBGGRR/\0", this instance's own
                                       * indirected validation buffer - the
                                       * Wimp reads it live, so recolouring
                                       * is just overwriting these bytes */
    } DividerPrivate;

    DividerPrivate *priv;
};

#endif
