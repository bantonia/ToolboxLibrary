#include "ToolboxGDivider.h"

ToolboxGDivider::ToolboxGDivider() : ToolboxGadget() {}

ToolboxGDivider::ToolboxGDivider(ObjectId windowId, ComponentId gadgetId) : ToolboxGadget(windowId, gadgetId) {}

ToolboxGDivider::ToolboxGDivider(ObjectId windowId, ComponentId gadgetId, unsigned int flags) : ToolboxGadget(windowId, gadgetId, flags) {}

ToolboxGDivider::~ToolboxGDivider() {
  remove();
}

ComponentId ToolboxGDivider::add(int window_handle, DividerGadget *divider) {
  _kernel_swi_regs regs;
  regs.r[3] = window_handle;
  regs.r[5] = (int)divider;
  ToolboxGadget::setLastError(_kernel_swi(Divider_Add, &regs, &regs), __LINE__);
  priv = (DividerPrivate *)regs.r[0];
  return priv->component_id;
}

ComponentId ToolboxGDivider::add(ToolboxWindowObj *object, DividerGadget *divider) {
  return add(object->getWimpHandle(), divider);
}

void ToolboxGDivider::remove() {
  _kernel_swi_regs regs;
  regs.r[3] = (int) priv;
  ToolboxGadget::setLastError(_kernel_swi(Divider_Remove, &regs, &regs), __LINE__);
}

ToolboxGDivider& ToolboxGDivider::fade(int fade) {
  _kernel_swi_regs regs;
  regs.r[3] = (int) priv;
  regs.r[4] = fade;
  ToolboxGadget::setLastError(_kernel_swi(Divider_Fade, &regs, &regs), __LINE__);
  return *this;
}

ToolboxGDivider& ToolboxGDivider::plot() {
  _kernel_swi_regs regs;
  regs.r[3] = (int) priv;
  ToolboxGadget::setLastError(_kernel_swi(Divider_Plot, &regs, &regs), __LINE__);
  return *this;
}

ToolboxGDivider& ToolboxGDivider::redraw(int originX, int originY) {
  _kernel_swi_regs regs;
  regs.r[3] = (int) priv;
  regs.r[7] = originX;
  regs.r[8] = originY;
  ToolboxGadget::setLastError(_kernel_swi(Divider_Redraw, &regs, &regs), __LINE__);
  return *this;
}

ToolboxGDivider& ToolboxGDivider::setColour(unsigned int colour) {
  _kernel_swi_regs regs;
  regs.r[4] = colour;
  this->gadgetMethod(Divider_SetColour, &regs);
  return *this;
}

void ToolboxGDivider::getColour(int& colour1, int& colour2, int& direction) {
  _kernel_swi_regs regs;
  this->gadgetMethod(Divider_GetColour, &regs);
  colour1 = regs.r[0];
  colour2 = regs.r[1];
  direction = regs.r[2];
}

ToolboxGDivider& ToolboxGDivider::setThickness(int thickness) {
  _kernel_swi_regs regs;
  regs.r[4] = thickness;
  this->gadgetMethod(Divider_SetThickness, &regs);
  return *this;
}

int ToolboxGDivider::getThickness() {
  _kernel_swi_regs regs;
  this->gadgetMethod(Divider_GetThickness, &regs);
  return regs.r[0];
}

ToolboxGDivider& ToolboxGDivider::setInset(int inset) {
  _kernel_swi_regs regs;
  regs.r[4] = inset;
  this->gadgetMethod(Divider_SetInset, &regs);
  return *this;
}

int ToolboxGDivider::getInset() {
  _kernel_swi_regs regs;
  this->gadgetMethod(Divider_GetInset, &regs);
  return regs.r[0];
}
