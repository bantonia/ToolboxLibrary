#include "ToolboxPartitionBar.h"

ToolboxPartitionBar::ToolboxPartitionBar() : ToolboxGadget() {}

ToolboxPartitionBar::ToolboxPartitionBar(ObjectId windowId, ComponentId gadgetId) : ToolboxGadget(windowId, gadgetId) {}

ToolboxPartitionBar::ToolboxPartitionBar(ObjectId windowId, ComponentId gadgetId, unsigned int flags) : ToolboxGadget(windowId, gadgetId, flags) {}

int ToolboxPartitionBar::getState() {
  _kernel_swi_regs regs;
  this->gadgetMethod(PartitionBar_GetState, &regs);
  return regs.r[0];
}

ToolboxPartitionBar& ToolboxPartitionBar::setState(int state) {
  _kernel_swi_regs regs;
  regs.r[4] = state;
  this->gadgetMethod(PartitionBar_SetState, &regs);
  return *this;
}

ToolboxPartitionBar& ToolboxPartitionBar::setSegments(PartitionBarSegment *segment) {
  _kernel_swi_regs regs;
  regs.r[4] = (int)segment;
  this->gadgetMethod(PartitionBar_SetSelected, &regs);
  return *this;
}

