#include "ToolboxEventTrigger.h"

ToolboxEventTrigger::ToolboxEventPtr ToolboxEventTrigger::head = NULL;
unsigned int ToolboxEventTrigger::lastTime = 0;

ToolboxEventTrigger::ToolboxEventTrigger(int objectId, int componentId, int event, int delay) {
  ToolboxEventBlock *p = (ToolboxEventBlock *) new ToolboxEventBlock;
  p->objectId = objectId;
  p->componentId = componentId;
  p->event = event;
  p->delay = delay;
  p->delay_count = delay;
  p->next = head;
  head = (ToolboxEventPtr) p;
  handle = head;
  if (lastTime == 0) {
    lastTime = OS::readMonotonicTime();
  }
}

ToolboxEventTrigger::~ToolboxEventTrigger() {
  ToolboxEventBlock *p = (ToolboxEventBlock *)head;
  while(p != NULL) {
    if (handle == (ToolboxEventPtr) p) {
      //***** head == handle *********
      head = (ToolboxEventPtr) p->next;
      delete ((ToolboxEventBlock *) handle);
      break;
    } else {
      if (handle == (ToolboxEventPtr) p->next) {
        p = (ToolboxEventBlock *) ((ToolboxEventBlock *)p->next)->next;
        delete ((ToolboxEventBlock *) handle);
        break;
      }
    }
    p = (ToolboxEventBlock *) p->next;
  }
}

void ToolboxEventTrigger::eventDispatcher() {
  if (head != NULL) {
    ToolboxEventBlock *p = (ToolboxEventBlock *)head;
    unsigned int nowTime = OS::readMonotonicTime();
    while(p != NULL) {
// Note: Rollover of OS::readMonotonicTime() not taken into consideration
      if((p->delay_count - ((int)(nowTime - lastTime))) <= 0) {
        p->delay_count = p->delay;
        //***** call Toolbox_RaiseToolboxEvent here ******
        ToolboxEvent event;
        event.hdr.size = 16;
        event.hdr.reference_number = 0;
        event.hdr.event_code = p->event;
        event.hdr.flags = 0;
        ToolboxCoreObj::raiseToolboxEvent(0, p->objectId, p->componentId, &event);
      } else {
        p->delay_count -= (nowTime - lastTime);
      }
      p = (ToolboxEventBlock *)(p->next);
    }
    lastTime = nowTime;
  }
}

