#include "ToolboxSpriteGrid.h"

ToolboxSpriteGrid::ToolboxSpriteGrid() : ToolboxGadget() {}

ToolboxSpriteGrid::ToolboxSpriteGrid(ObjectId windowId, ComponentId gadgetId) : ToolboxGadget(windowId, gadgetId) {}

ToolboxSpriteGrid::ToolboxSpriteGrid(ObjectId windowId, ComponentId gadgetId, unsigned int flags) : ToolboxGadget(windowId, gadgetId, flags) {}

ToolboxSpriteGrid& ToolboxSpriteGrid::setSprites(char *names) {
  _kernel_swi_regs regs;
  regs.r[4] = (int) names;
  this->gadgetMethod(SpriteGrid_SetSprites, &regs);
  return *this;
}

void ToolboxSpriteGrid::getSprites(char& buffer, int size, int& nbytes) {
  _kernel_swi_regs regs;
  regs.r[4] = (int) buffer;
  regs.r[5] = size;
  this->gadgetMethod(SpriteGrid_GetSprites, &regs);
  nbytes = regs.r[5];
}

