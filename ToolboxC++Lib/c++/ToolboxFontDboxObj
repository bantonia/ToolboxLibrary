#include "ToolboxFontDboxObj.h"

ToolboxFontDboxObj::ToolboxFontDboxObj(): ToolboxObj() {}

ToolboxFontDboxObj::ToolboxFontDboxObj(ObjectId objectId) : ToolboxObj(objectId) {}

ToolboxFontDboxObj::ToolboxFontDboxObj(IdBlock *idBlock) : ToolboxObj(idBlock) {}

ToolboxFontDboxObj::~ToolboxFontDboxObj() {}

int ToolboxFontDboxObj::getWindowId() {
  _kernel_swi_regs regs;
  regs.r[2] = FontDbox_GetWindowId;
  this->objectMiscOp(&regs);
  return regs.r[0];
}

ToolboxFontDboxObj& ToolboxFontDboxObj::clearFont() {
  _kernel_swi_regs regs;
  regs.r[2] = FontDbox_SetFont;
  regs.r[3] = 0;
  this->objectMiscOp(&regs);
  return *this;
}

ToolboxFontDboxObj& ToolboxFontDboxObj::setFont(char *fontId) {
  _kernel_swi_regs regs;
  regs.r[2] = FontDbox_SetFont;
  regs.r[3] = (int) fontId;
  this->objectMiscOp(&regs);
  return *this;
}

int ToolboxFontDboxObj::getFont() {
  _kernel_swi_regs regs;
  regs.r[2] = FontDbox_GetFont;
  regs.r[3] = 0;
  this->objectMiscOp(&regs);
  return regs.r[4];
}

int ToolboxFontDboxObj::getFont(char *buffer, int bufSize) {
  _kernel_swi_regs regs;
  regs.r[2] = FontDbox_GetFont;
  regs.r[3] = (int) buffer;
  regs.r[4] = bufSize;
  this->objectMiscOp(&regs);
  return regs.r[4];
}

ToolboxFontDboxObj& ToolboxFontDboxObj::setSize(int height, int aspectRatio) {
  _kernel_swi_regs regs;
  regs.r[2] = FontDbox_SetSize;
  regs.r[3] = height;
  regs.r[4] = aspectRatio;
  this->objectMiscOp(&regs);
  return *this;
}

ToolboxFontDboxObj& ToolboxFontDboxObj::getSize(int *height, int *aspectRatio) {
  _kernel_swi_regs regs;
  regs.r[2] = FontDbox_GetSize;
  this->objectMiscOp(&regs);
  *height = regs.r[0];
  *aspectRatio = regs.r[1];
  return *this;
}

