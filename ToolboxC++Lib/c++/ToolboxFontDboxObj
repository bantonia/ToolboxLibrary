ToolboxFontDboxObj& ToolboxFontDboxObj::setObjectId(ObjectId objectId) {
  this->ToolboxObj::setObjectId(objectId);
  return *this;
}

ToolboxFontDboxObj& ToolboxFontDboxObj::setFlags(unsigned int flags) {
