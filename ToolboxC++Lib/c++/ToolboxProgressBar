#include "ToolboxProgressBar.h"

ToolboxProgressBar::ToolboxProgressBar() : ToolboxGadget() {}

ToolboxProgressBar::ToolboxProgressBar(ObjectId windowId, ComponentId gadgetId) : ToolboxGadget(windowId, gadgetId) {}

ToolboxProgressBar::ToolboxProgressBar(ObjectId windowId, ComponentId gadgetId, unsigned int flags) : ToolboxGadget(windowId, gadgetId, flags) {}

int ToolboxProgressBar::getState() {
  _kernel_swi_regs regs;
  this->gadgetMethod(ProgressBar_GetState, &regs);
  return regs.r[0];
}

ToolboxProgressBar& ToolboxProgressBar::setState(int state) {
  _kernel_swi_regs regs;
  regs.r[4] = state;
  this->gadgetMethod(ProgressBar_SetState, &regs);
  return *this;
}

